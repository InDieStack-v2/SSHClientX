{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is SSHClientX free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. SSHClientX is MIT-licensed open source. Personal use, commercial use, fork and redistribute — all allowed."
      }
    },
    {
      "@type": "Question",
      "name": "Which platforms does SSHClientX support?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Windows 10 and 11, macOS (Apple Silicon and Intel via Rosetta), all major Linux distributions (.deb, .rpm, Arch package, AppImage), and Android 8.0+ as a sideloadable APK."
      }
    },
    {
      "@type": "Question",
      "name": "How is SSHClientX different from PuTTY, WinSCP, or MobaXterm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PuTTY and WinSCP are two separate apps you alt-tab between. MobaXterm bundles them but is Windows-only and feels dated. SSHClientX combines terminal, SFTP, tunnels, and folder mirror in one modern tabbed window per server, and runs natively on Windows, macOS, Linux, and Android."
      }
    },
    {
      "@type": "Question",
      "name": "Does SSHClientX have an account or a backend server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. SSHClientX has no account, no sign-up, and no backend of any kind. Your master password derives the vault key on your device with Argon2id, and every profile is sealed with AES-256-GCM before it touches disk. Nothing is ever uploaded — there is no server that could be breached."
      }
    },
    {
      "@type": "Question",
      "name": "Does SSHClientX support port forwarding and SOCKS proxies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — local (-L), remote (-R), and dynamic (-D) tunnels. Dynamic tunnels speak SOCKS4, SOCKS4a, SOCKS5, SOCKS5h, HTTP CONNECT, and plain HTTP proxy. Tunnels reconnect automatically and can be started at app launch."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use the same servers on desktop and on my Android phone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The encrypted vault file is platform-portable. Export a profile from desktop and import that same file on the mobile app, then unlock it with the same master password — every saved server, key, and tunnel comes across."
      }
    },
    {
      "@type": "Question",
      "name": "Does SSHClientX collect telemetry or analytics?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. There is no analytics SDK, no crash reporter that sends data home, no telemetry, and no account or backend of any kind. The only outbound network activity beyond your own SSH targets is an update check against GitHub releases."
      }
    }
  ]
}
