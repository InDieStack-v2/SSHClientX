# Maintainer: Sina <https://sinaxhpm.com>
#
# This PKGBUILD is intended to be driven by the GitHub Actions release
# workflow, not built standalone from an unpacked tarball. CI stamps the
# real version into pkgver at build time and drops the prebuilt Linux
# binary + .desktop + icon next to this file before invoking makepkg,
# so package() can install straight from $startdir with no source= /
# download step.
#
# If you want to build it yourself: copy the release binary into this
# directory as `sshclientx`, copy sshclientx.desktop and icon.png in, then
# run `makepkg -f`.
#
# sshclientx-mime.xml (FR-037: file-type registration, no content
# previews) ships alongside this PKGBUILD in the repo — no CI step needed
# to produce it, unlike the binary/.desktop/icon.

pkgname=sshclientx
pkgver=0.0.0
pkgrel=1
pkgdesc='A modern, secure SSH/SFTP desktop client'
arch=('x86_64')
url='https://github.com/InDieStack-v2/SSHClientX'
license=('MIT')
# Runtime libs the Tauri release binary links against. webkit2gtk-4.1 +
# gtk3 + libsoup3 match the same triple the AppImage/.deb depends on.
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3')
optdepends=('libayatana-appindicator: system-tray icon support')
# Binary is already release-built and stripped by the toolchain; running
# makepkg's strip pass again is a no-op and just slows the build.
options=('!strip')

package() {
  install -Dm755 "$startdir/sshclientx"         "$pkgdir/usr/bin/sshclientx"
  install -Dm644 "$startdir/sshclientx.desktop" "$pkgdir/usr/share/applications/sshclientx.desktop"
  install -Dm644 "$startdir/icon.png"          "$pkgdir/usr/share/icons/hicolor/512x512/apps/sshclientx.png"
  # FR-037: registers .sshclientx as its own MIME type so file managers
  # recognise it and route double-click opens to this app. shared-mime-info
  # and desktop-file-utils' own ALPM hooks refresh the system databases on
  # install — no separate update-mime-database/update-desktop-database call
  # needed here.
  install -Dm644 "$startdir/sshclientx-mime.xml" "$pkgdir/usr/share/mime/packages/sshclientx.xml"
}
